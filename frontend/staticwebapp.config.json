{
  "navigationFallback": {
    "rewrite": "/placeholder/index.html",
    "exclude": [
      "/_next/*",
      "/manifest.json",
      "/robots.txt",
      "/sw.js",
      "/sitemap.xml",
      "/icons/*",
      "/google*.html",
      "/*.png",
      "/*.ico",
      "/*.svg"
    ]
  },
  "routes": [
    { "route": "/auth/login", "rewrite": "/auth/login/index.html" },
    { "route": "/auth/callback", "rewrite": "/auth/callback/index.html" },
    { "route": "/profile", "rewrite": "/profile/index.html" },
    { "route": "/invite", "rewrite": "/invite/index.html" },
    { "route": "/admin/login", "rewrite": "/admin/login/index.html" },
    { "route": "/api/*", "allowedRoles": ["anonymous"] }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Cache-Control": "public, max-age=0, must-revalidate"
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
