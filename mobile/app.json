{
  "expo": {
    "name": "LocalsIndia",
    "slug": "localsindia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "localsindia",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7921E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localsindia.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to sign in to LocalsIndia quickly and securely.",
        "NSLocationWhenInUseUsageDescription": "LocalsIndia uses your approximate location to show nearby listings first. This is optional — search still works without it."
      }
    },
    "android": {
      "package": "com.localsindia.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7921E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-local-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LocalsIndia to access your photos so you can add pictures to your listings."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F7921E"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocalsIndia uses your approximate location to show nearby listings first. This is optional — search still works without it."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "28f874d0-a40c-4089-90b9-34cf2bf0a83a"
      }
    },
    "owner": "rajeshguntupalli59"
  }
}
