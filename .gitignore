# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Env files
.env
.env.local
.env.production
*.env
.env.*
agents/.env.agents

# Agent output (generated content — don't commit)
agents/output/*
!agents/output/.gitkeep
# Exceptions: these are small, durable activity logs (not generated media),
# committed back to the repo by social-poster.yml so posting history survives
# past the ephemeral CI runner it was generated on — otherwise there is no
# record of FB/IG posting activity anywhere.
!agents/output/social_posts_log.jsonl
!agents/output/ecosystem_posts_log.jsonl

# Node
node_modules/
.next/
out/

# Build artifacts
dist/
build/
*.egg-info/

# Test coverage
.coverage
htmlcov/
coverage/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
pgdata/
.railway/
.gstack/

# Local dev tool caches (generated, not source)
.codegraph/
graphify-out/
